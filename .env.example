PORT=3000
NODE_ENV=development

# 1. AWS Credentials (EC2 & CloudWatch)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# 2. Azure Credentials (Virtual Machines & Azure Monitor)
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret

# 3. Google Cloud (GCP) Credentials (Compute Engine & Cloud Monitoring)
GCP_PROJECT_ID=your_gcp_project_id
GCP_ACCESS_TOKEN=your_gcp_access_token_or_service_account_token
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account-key.json
